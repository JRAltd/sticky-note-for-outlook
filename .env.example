# ============================================================================
# Outlook Sticky Notes Add-in - Environment Configuration
# ============================================================================
# Note: The add-in works out-of-the-box with zero Azure configuration using
# Office.js CustomProperties + RoamingSettings.
#
# To ALSO enable Microsoft Graph Open Extensions (com.jraltd.emailNotes),
# register an Azure AD app and populate the values below (or configure them
# directly inside the Add-in's Settings drawer at runtime).

VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=common
VITE_AZURE_REDIRECT_URI=https://localhost:3000/taskpane.html
VITE_GRAPH_EXTENSION_NAME=com.jraltd.emailNotes
VITE_DEFAULT_STORAGE_MODE=hybrid
