<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Enterprise / M365 Admin Center Deployment Manifest Template
  Replace:
    - YOUR_PRODUCTION_DOMAIN (e.g. notes-addin.yourdomain.com)
    - YOUR_AZURE_AD_CLIENT_ID (GUID from Microsoft Entra ID App Registration)
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>8a4e91c2-5b7d-4e3a-9f12-6c8d3e4f5a6b</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>JRAltd Workshop</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Email Sticky Notes"/>
  <Description DefaultValue="Enterprise Email Sticky Notes with Office.js CustomProperties and Microsoft Graph Open Extensions."/>
  <IconUrl DefaultValue="https://YOUR_PRODUCTION_DOMAIN/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://YOUR_PRODUCTION_DOMAIN/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://YOUR_PRODUCTION_DOMAIN/taskpane.html"/>

  <AppDomains>
    <AppDomain>https://YOUR_PRODUCTION_DOMAIN</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
    <AppDomain>https://graph.microsoft.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://YOUR_PRODUCTION_DOMAIN/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgReadGroupProd">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="msgReadOpenPaneButtonProd">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://YOUR_PRODUCTION_DOMAIN/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://YOUR_PRODUCTION_DOMAIN/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://YOUR_PRODUCTION_DOMAIN/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://YOUR_PRODUCTION_DOMAIN/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://YOUR_PRODUCTION_DOMAIN/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Sticky Notes"/>
          <bt:String id="TaskpaneButton.Label" DefaultValue="Email Notes"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open Email Sticky Notes to manage notes attached to this email."/>
        </bt:LongStrings>
      </Resources>
      <WebApplicationInfo>
        <Id>YOUR_AZURE_AD_CLIENT_ID</Id>
        <Resource>api://YOUR_PRODUCTION_DOMAIN/YOUR_AZURE_AD_CLIENT_ID</Resource>
        <Scopes>
          <Scope>User.Read</Scope>
          <Scope>Mail.ReadWrite</Scope>
          <Scope>openid</Scope>
          <Scope>profile</Scope>
        </Scopes>
      </WebApplicationInfo>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
